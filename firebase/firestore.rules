rules_version = '2';

// ============================================================================
//  REGLAS DE SEGURIDAD DE FIRESTORE — Tatiana Hernández · Estética Integral
//  SISTEMA DE ADMINISTRACIÓN (Fase 1: usuarios, clientes, profesionales, servicios)
//
//  Modelo de roles: cada usuaria del PANEL tiene un documento en /usuarios/{uid}
//  con un campo `rol` ('admin' | 'recepcion' | 'profesional') y `activo` (bool).
//  Las reglas leen ese documento para decidir permisos. El rol NUNCA se confía
//  desde el cliente: se lee del servidor (get) contra la identidad autenticada.
//
//  Las clientas del sitio público (login por teléfono) NO tienen /usuarios/{uid};
//  por eso las funciones de staff devuelven false para ellas, y solo conservan
//  acceso a sus propias /citas (ver más abajo), sin tocar las colecciones del panel.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers de identidad y rol ----------
    function signedIn() { return request.auth != null; }

    function tieneUsuario() {
      return signedIn()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }
    function perfil() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }
    function rol() { return tieneUsuario() ? perfil().rol : 'ninguno'; }
    function activo() { return tieneUsuario() && perfil().activo == true; }

    function esAdmin()      { return rol() == 'admin' && activo(); }
    function esRecepcion()  { return rol() == 'recepcion' && activo(); }
    function esProfesional(){ return rol() == 'profesional' && activo(); }
    function esStaff()      { return (esAdmin() || esRecepcion()); }           // mostrador + dirección
    function esPanel()      { return (esAdmin() || esRecepcion() || esProfesional()); } // cualquier usuaria del panel

    // ============================ USUARIOS ============================
    // Administradoras autorizadas para crear su propio acceso en el primer ingreso.
    function correoBootstrap() {
      return signedIn() && request.auth.token.email != null
        && request.auth.token.email.lower() in [
          'yuliethhernandezrtpo1991@gmail.com',
          'biohazaa@gmail.com'
        ];
    }
    match /usuarios/{uid} {
      allow read: if esAdmin() || (signedIn() && request.auth.uid == uid);
      // Crear: un admin crea a cualquiera; o una administradora autorizada crea
      // SU PROPIO documento como 'admin' (solo su UID, solo esos correos).
      allow create: if esAdmin()
        || (correoBootstrap()
            && request.auth.uid == uid
            && request.resource.data.rol == 'admin');
      allow update, delete: if esAdmin();
    }

    // ============================ CLIENTES ============================
    match /clientes/{id} {
      allow read:   if esPanel();                 // todo el panel puede consultar
      allow create, update: if esStaff();         // admin o recepción
      allow delete: if esAdmin();                 // preferir inactivar; borrar solo admin
    }

    // ========================== PROFESIONALES =========================
    match /profesionales/{id} {
      allow read:   if esPanel();
      allow create, update, delete: if esAdmin();
    }

    // ============================ SERVICIOS ===========================
    match /servicios/{id} {
      allow read:   if esPanel();
      allow create, update, delete: if esAdmin();
    }

    // ============================= PAGOS ==============================
    match /pagos/{id} {
      allow read:   if esStaff();
      allow create, update: if esStaff();
      allow delete: if esAdmin();
    }

    // ======================= FICHAS DE ATENCIÓN =======================
    // Datos sensibles. Lee el staff; el profesional ve/edita las suyas.
    match /fichas/{id} {
      allow read:   if esStaff()
                    || (esProfesional() && resource.data.profesionalUid == request.auth.uid);
      allow create: if esStaff()
                    || (esProfesional() && request.resource.data.profesionalUid == request.auth.uid);
      allow update: if esStaff()
                    || (esProfesional() && resource.data.profesionalUid == request.auth.uid);
      allow delete: if esAdmin();
    }

    // ============================ AUDITORÍA ===========================
    // Registro de cambios: cualquier usuaria del panel agrega; solo admin lee; no se edita/borra.
    match /auditoria/{id} {
      allow create: if esPanel();
      allow read:   if esAdmin();
      allow update, delete: if false;
    }

    // ================================================================
    //  AGENDA PÚBLICA (clientas por teléfono) — se conserva igual.
    //  (Se reconciliará con el módulo de Agenda del panel en la Fase 2.)
    // ================================================================
    match /citas/{citaId} {
      allow read:   if (signedIn() && resource.data.userId == request.auth.uid) || esStaff();
      allow create: if signedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.estado == 'confirmada'
                    && request.resource.data.horarioId is string;
      allow update: if (signedIn() && resource.data.userId == request.auth.uid
                        && request.resource.data.userId == resource.data.userId)
                    || esStaff();
      allow delete: if false;
    }

    match /horarios/{horarioId} {
      allow read:   if signedIn();
      allow create: if esStaff()
                    && request.resource.data.estado in ['disponible','reservado'];
      allow update: if signedIn()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado'])
                    && request.resource.data.estado in ['disponible','reservado'];
      allow delete: if esStaff();
    }
  }
}
